# ARGs before FROM are used in the FROM instruction
# these must be overridden via --build-arg
ARG PARENT_REGISTRY_PREFIX=dummy_parent_registry_prefix
ARG PARENT_REPOSITORY=dummy_parent_repository
ARG PARENT_TAG=dummy_parent_tag
FROM ${PARENT_REGISTRY_PREFIX}/${PARENT_REPOSITORY}:${PARENT_TAG}

# Re-declare ARGs after FROM to use them in subsequent instructions
ARG PARENT_REGISTRY_PREFIX
ARG PARENT_REPOSITORY
ARG PARENT_TAG

# LMCache installation arguments
# - rocm/7.0:rocm7.0_ubuntu_22.04_vllm_0.10.1_instinct_20250915 = LMCache v0.3.5      = 4409b09
# - rocm/vllm:rocm7.0.0_vllm_0.11.1_20251103                    = LMCache v0.3.9post2 = d5be14f
# - vllm/vllm-openai-rocm:v0.16.0                               = LMCache v0.3.15     = 9dc3ab7
# - vllm/vllm-openai-rocm:v0.19.0                               = LMCache v0.4.4      = 6fbec46
# - vllm/vllm-openai-rocm:v0.21.0                               = LMCache v0.4.6      = a7f22be
# - vllm/vllm-openai-rocm:v0.23.0                               = LMCache v0.4.7      = 307439a
# - vllm/vllm-openai-rocm:v0.25.1                               = LMCache v0.5.2      = cd2c0d6
# - vllm/vllm-openai-rocm:v0.26.0                               = LMCache v0.5.2      = cd2c0d6
# - vllm/vllm-openai-rocm:v0.27.1                               = LMCache v0.5.2      = cd2c0d6
ARG INSTALL_LMCACHE=true
ARG INSTALL_LMCACHE_COMMIT=cd2c0d6

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH="/workspace/aim-runtime/src${PYTHONPATH:+:${PYTHONPATH}}"
ENV HF_HOME="/workspace/model-cache"
ENV HF_DATASETS_CACHE="/workspace/model-cache"
ENV HF_HUB_DISABLE_TELEMETRY="1"
ENV AIM_UPSTREAM_IMAGE_REF=${PARENT_REGISTRY_PREFIX}/${PARENT_REPOSITORY}:${PARENT_TAG}
ENV AIM_ALLOW_GENERAL_PROFILE_FALLBACK="true"
ENV AIM_ACCELERATOR_FAMILY="instinct"
ENV AIM_ACCELERATOR_TYPE="gpu"
ENV AIM_CONFIG_PATH="/workspace/aim-runtime/config"

RUN echo "AIM Upstream Image: ${AIM_UPSTREAM_IMAGE_REF}"

# Create workspace directory
WORKDIR /workspace

# Copy AIM Runtime source code (only runtime packages, not developer tooling)
COPY src/aim_runtime/ /workspace/aim-runtime/src/aim_runtime/
COPY src/aim_common/ /workspace/aim-runtime/src/aim_common/
COPY requirements/requirements.txt /workspace/aim-runtime/
COPY requirements/${AIM_ACCELERATOR_FAMILY}-requirements.txt /workspace/aim-runtime/
COPY src/entrypoint.py /workspace/entrypoint.py
RUN chmod +x /workspace/entrypoint.py

# Engine config and general-profile directories to copy into the image.
# Defaults match the standard (legacy vLLM) base layout. Named/specialized base
# targets override these via build args (see .github/actions/build-image) so each
# ships only its own engines.yaml and general profiles — the generic vLLM general
# profiles are not copied into non-legacy bases.
ARG AIM_BASE_CONFIG_DIR=assets/instinct/base/config
ARG AIM_BASE_PROFILES_DIR=assets/instinct/base/profiles/general

# Copy general profiles and engine config
COPY ${AIM_BASE_PROFILES_DIR} /workspace/aim-runtime/profiles/general
COPY ${AIM_BASE_CONFIG_DIR} /workspace/aim-runtime/config

# Install runtime dependencies
RUN cd /workspace/aim-runtime && \
    pip3 install -r requirements.txt && \
    pip3 install -r ${AIM_ACCELERATOR_FAMILY}-requirements.txt

# Install LMCache for KV-caching support (conditional based on INSTALL_LMCACHE)
# We install from source using commit hash corresponding to a particular release tag, for supply-chain security (immutable reference).
# BUILD_WITH_HIP=1 selects the ROCm extension path in setup.py and pulls cupy-rocm-7-0
# instead of the CUDA-only nixl/cupy-cuda12x stack, avoiding libcuda.so.1 at runtime.
RUN if [ "$INSTALL_LMCACHE" = "true" ]; then \
        cd /workspace && \
        git clone https://github.com/LMCache/LMCache.git && \
        cd LMCache && \
        git checkout "${INSTALL_LMCACHE_COMMIT}" && \
        pip3 install -r requirements/build.txt && \
        BUILD_WITH_HIP=1 \
        CXX=hipcc \
        TORCH_DONT_CHECK_COMPILER_ABI=1 \
        python3 -m pip install --no-build-isolation . && \
        cd /workspace && \
        rm -rf LMCache; \
    else \
        echo "Skipping LMCache installation (INSTALL_LMCACHE=${INSTALL_LMCACHE})"; \
    fi

# Install any base-flavor extra deps shipped in its config dir (copied above). Done
# last, after LMCache, so nothing downstream re-pins them. vllm-omni uses this for
# huggingface-hub 1.x, which both the instinct lock and the LMCache build downgrade.
RUN if [ -f "${AIM_CONFIG_PATH}/requirements-extra.txt" ]; then \
        echo "Installing base extra requirements from ${AIM_CONFIG_PATH}/requirements-extra.txt"; \
        pip3 install --no-cache-dir -r "${AIM_CONFIG_PATH}/requirements-extra.txt"; \
    fi

# Accuracy-evaluation backend for `aim-runtime evaluate`.
# Installed into its own virtualenv, never into the serving environment: lm-eval
# pins transformers/numpy/datasets versions of its own, and upgrading those in
# place would rebind the interpreter that serves the model. `evaluate` runs the
# backend as a subprocess, so an isolated venv costs nothing at serving time —
# and the pinned set carries no torch, so the venv adds no framework copy.
# Opt-in per base target via assets/<accelerator>/base/config.yaml
# (install_evaluation_deps); prod images can ship without it.
ARG INSTALL_EVALUATION_DEPS=false
COPY requirements/evaluation-requirements.txt /workspace/aim-runtime/
RUN if [ "$INSTALL_EVALUATION_DEPS" = "true" ]; then \
        python3 -m venv /workspace/tools/eval-venv && \
        /workspace/tools/eval-venv/bin/pip install --no-cache-dir --upgrade pip && \
        /workspace/tools/eval-venv/bin/pip install --no-cache-dir \
            -r /workspace/aim-runtime/evaluation-requirements.txt && \
        /workspace/tools/eval-venv/bin/lm_eval --help > /dev/null; \
    else \
        echo "Skipping evaluation dependencies (INSTALL_EVALUATION_DEPS=${INSTALL_EVALUATION_DEPS})"; \
    fi

# Points `aim-runtime evaluate` at the venv above. Set unconditionally: when the
# venv was not installed the availability probe reports this exact path as
# missing, which names the remediation better than a bare "lm_eval not found".
# Must match IN_IMAGE_BACKEND_COMMAND in src/aim_runtime/evaluation/config.py.
ENV AIM_EVAL_BACKEND_COMMAND="/workspace/tools/eval-venv/bin/lm_eval"

# Pre-built AITER JIT attention kernels (per GPU architecture).
# Built by CI on a GPU pod, stored as a container image in GHCR.
# At runtime, the matching arch's kernels are copied into AITER's system
# JIT directory so AITER finds them without needing AITER_JIT_DIR override.
# See docker/aiter-jit-prebuilt/README.md for details.
ARG AITER_KERNEL_CHECKSUM=""
ENV AITER_KERNEL_CHECKSUM=${AITER_KERNEL_CHECKSUM}
COPY docker/aiter-jit-prebuilt/kernels/ /workspace/aiter-jit-prebuilt/

# Create cache directories
RUN mkdir -p /workspace/model-cache

# Copy License files (placed late to preserve build cache for expensive preceding layers)
COPY LICENSE /workspace/LICENSE

ENTRYPOINT ["./entrypoint.py"]
