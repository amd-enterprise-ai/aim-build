+# torch.compile dispatcher. Gated by OPENFOLD3_COMPILE_* env vars read
+# at first forward(). Applied at AMD AIM image build time; not part of
+# upstream OF3.
+
+# Raise dynamo's per-frame recompile cache from the 8 default. With
+# dynamic=False (static-shape compile per recipe) every distinct input
+# length is a new entry; serving 21+ sequence sizes back-to-back blows
+# the default and falls back to eager for the rest of the workload.
+# 64 gives 3x headroom over the 21-PDB benchmark suite and a healthy
+# margin for production protein-length diversity, while keeping the
+# compile-cache footprint well under 10 GB HBM and disk per wrapped
+# submodule.
+torch._dynamo.config.recompile_limit = 64
+
+_OF3_VALID_BACKENDS = ("none", "inductor")
+_VALID_INDUCTOR_MODES = (
+    "default",
+    "reduce-overhead",
+    "max-autotune",
+    "max-autotune-no-cudagraphs",
+)
+
+
+def _get_compile_backend(env_var: str) -> str:
+    val = os.environ.get(env_var, "none").strip().lower()
+    if val not in _OF3_VALID_BACKENDS:
+        print(
+            f"[OF3_COMPILE] WARNING: {env_var}={val!r} not in "
+            f"{_OF3_VALID_BACKENDS}; using 'none'.",
+            flush=True,
+        )
+        return "none"
+    return val
+
+
+def _maybe_compile(module, env_var, *, inductor_mode=None, mode_env_var=None, label=None):
+    backend = _get_compile_backend(env_var)
+    tag = label or module.__class__.__name__
+    if backend == "none":
+        return module
+    effective_mode = inductor_mode
+    if mode_env_var is not None:
+        override = os.environ.get(mode_env_var, "").strip().lower()
+        if override in _VALID_INDUCTOR_MODES:
+            effective_mode = override
+        elif override:
+            print(
+                f"[OF3_COMPILE] WARNING: {mode_env_var}={override!r} invalid; "
+                f"using {effective_mode!r}.",
+                flush=True,
+            )
+    kwargs = {"backend": backend, "fullgraph": False, "dynamic": False}
+    if effective_mode is not None:
+        kwargs["mode"] = effective_mode
+    print(
+        f"[OF3_COMPILE] Compiling {tag} via {env_var}: backend={backend} "
+        f"mode={kwargs.get('mode', '<default>')}",
+        flush=True,
+    )
+    return torch.compile(module, **kwargs)
+
+
+def _compile_submodule_attr(
+    parent, attr_name, env_var, *, inductor_mode_default=None, label_prefix=""
+):
+    if _get_compile_backend(env_var) == "none":
+        return False
+    child = getattr(parent, attr_name, None)
+    if child is None:
+        print(
+            f"[OF3_COMPILE] WARNING: {env_var} requested but "
+            f"{parent.__class__.__name__!r} has no {attr_name!r}.",
+            flush=True,
+        )
+        return False
+    setattr(
+        parent,
+        attr_name,
+        _maybe_compile(
+            child,
+            env_var,
+            inductor_mode=inductor_mode_default,
+            mode_env_var=f"{env_var}_MODE",
+            label=f"{label_prefix}{attr_name}",
+        ),
+    )
+    return True
+
+
+def _apply_inductor_config_overrides() -> None:
+    """Opt-in TorchInductor knobs, applied once before any torch.compile wrap.
+
+    Used by the medium+ GEMM-maxautotune champion. Both are no-ops unless the
+    env var is set, so small / diff-only recipes are unaffected.
+
+    OPENFOLD3_INDUCTOR_GEMM_BACKENDS=<csv> -> max_autotune_gemm_backends (also
+                                              forces max_autotune_gemm=True). The
+                                              champion uses "TRITON".
+    OPENFOLD3_INDUCTOR_CD_TUNE=1           -> coordinate_descent_tuning.
+    """
+    flags = {"OPENFOLD3_INDUCTOR_CD_TUNE": "coordinate_descent_tuning"}
+    requested = {e: a for e, a in flags.items() if os.environ.get(e, "") == "1"}
+    gemm_backends = os.environ.get("OPENFOLD3_INDUCTOR_GEMM_BACKENDS", "").strip()
+    if not requested and not gemm_backends:
+        return
+    from torch._inductor import config as _ind_cfg
+
+    if gemm_backends:
+        _ind_cfg.max_autotune_gemm = True
+        _ind_cfg.max_autotune_gemm_backends = gemm_backends
+        print(
+            f"[OF3_COMPILE] Inductor config: max_autotune_gemm=True, "
+            f"max_autotune_gemm_backends={gemm_backends!r}",
+            flush=True,
+        )
+    for env, attr in requested.items():
+        if hasattr(_ind_cfg, attr):
+            setattr(_ind_cfg, attr, True)
+            print(f"[OF3_COMPILE] Inductor config: {attr}=True (via {env})", flush=True)
+
