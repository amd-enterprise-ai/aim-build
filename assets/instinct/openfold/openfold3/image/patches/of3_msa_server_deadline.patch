+# Every retry loop in query_colabfold_msa_server below is unbounded: submit(),
+# status() and download() each wrap their HTTP call in `while True`, and the
+# RATELIMIT path resubmits forever. Once the server throttles a caller there is
+# no exit but success, so a query can outlive any serving timeout -- and a
+# serving layer that runs this on a thread cannot cancel it. These give the
+# loops a wall clock to respect.
+#
+# A ContextVar rather than a global so it stays correct with more than one
+# request in flight per process; anyio copies the context into worker threads,
+# so it is visible where the loops read it.
+_MSA_DEADLINE: contextvars.ContextVar[float | None] = contextvars.ContextVar(
+    "of3_msa_deadline", default=None
+)
+
+MSA_TIMEOUT_ENV_VAR = "OPENFOLD3_MSA_TIMEOUT_SECONDS"
+
+
+class MsaServerTimeout(Exception):
+    """The MSA server did not finish within the caller's budget."""
+
+
+@contextlib.contextmanager
+def msa_deadline(deadline: float | None):
+    """Bound MSA-server work in this context to a ``time.monotonic()`` deadline.
+
+    Absolute rather than a duration so that the several server queries a single
+    prediction makes share one budget instead of each getting a fresh one.
+    """
+    token = _MSA_DEADLINE.set(deadline)
+    try:
+        yield
+    finally:
+        _MSA_DEADLINE.reset(token)
+
+
+def _unreachable_message(phase: str, attempts: int, exc: Exception) -> str:
+    """Message for giving up on an unreachable server, in the deadline's voice.
+
+    Retry exhaustion and deadline expiry are the same thing to a caller — the
+    MSA server did not deliver — so both raise MsaServerTimeout and both get a
+    503. Reporting one as a generic failure would tell the caller to stop
+    retrying something that is only transiently unavailable.
+    """
+    return (
+        f"MSA server unreachable after {attempts} attempts (gave up while {phase}): {exc}. "
+        "It is most likely rate-limiting this client: retry later, point server_url at a "
+        "self-hosted MMseqs2 server, or supply MSAs directly and set use_msa_server=False."
+    )
+
+
+def _resolve_msa_deadline() -> float | None:
+    """The active deadline, falling back to the env var when none is set.
+
+    The fallback is per call, so it bounds each server query rather than the
+    whole prediction; callers wanting one budget for the request should use
+    ``msa_deadline``.
+    """
+    deadline = _MSA_DEADLINE.get()
+    if deadline is not None:
+        return deadline
+
+    raw = os.environ.get(MSA_TIMEOUT_ENV_VAR, "").strip()
+    if not raw:
+        return None
+    try:
+        budget = float(raw)
+    except ValueError:
+        logger.warning("Ignoring non-numeric %s=%r", MSA_TIMEOUT_ENV_VAR, raw)
+        return None
+    return time.monotonic() + budget if budget > 0 else None
+
