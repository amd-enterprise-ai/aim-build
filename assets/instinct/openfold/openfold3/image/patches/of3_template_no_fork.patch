 logger = logging.getLogger(__name__)
 
 
+def _map_items(fn, items, *, n_processes: int, chunksize: int, desc: str) -> None:
+    """Apply ``fn`` to every item, forking only when more than one process is asked for.
+
+    ``mp.Pool`` forks even for a single worker. A caller that dispatches work to
+    a thread — a serving layer running sync handlers on a worker thread, for
+    instance — then forks from a non-main thread, and the child can inherit a
+    lock held by another thread; the pool's ``join()`` on teardown never
+    returns. Python warns about this (``DeprecationWarning: This process is
+    multi-threaded, use of fork() may lead to deadlocks in the child``).
+
+    With ``n_processes <= 1`` there is no parallelism to gain, so run in-process
+    and avoid the fork entirely. The progress bar and the order of side effects
+    are unchanged.
+    """
+    if n_processes <= 1:
+        for item in tqdm(items, total=len(items), desc=desc):
+            fn(item)
+        return
+
+    with mp.Pool(n_processes) as pool:
+        for _ in tqdm(
+            pool.imap_unordered(fn, items, chunksize=chunksize),
+            total=len(items),
+            desc=desc,
+        ):
+            pass
+
+
