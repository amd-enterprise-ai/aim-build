**/*.pt
**/*.pth
**/*.bin
**/*.safetensors
**/*.onnx
**/*.h5
**/*.npz
**/*.nc
**/*.grib
**/*.grib2
**/*.pickle
**/*.pkl
**/*.tar
**/*.zip

# Tests are mounted at smoke time, not baked.
tests/
pytest.ini

**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/._*
**/.DS_Store
